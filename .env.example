# Copy to .env and fill in your own values. Never commit .env.
POSTGRES_DB=ci_demo
POSTGRES_USER=ci_demo_user
# Required: docker compose refuses to start while this is empty.
POSTGRES_PASSWORD=

# Only used when running the app without Docker (docker compose builds its own URL).
# Replace <password>, URL-encoding any special characters.
DATABASE_URL=postgresql://ci_demo_user:<password>@localhost:5432/ci_demo
